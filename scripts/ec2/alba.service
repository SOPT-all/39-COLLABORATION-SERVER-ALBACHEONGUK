[Unit]
Description=Alba API
After=network.target

[Service]
DynamicUser=yes
WorkingDirectory=/opt/alba
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_PORT=8080
Environment=SERVER_FORWARD_HEADERS_STRATEGY=framework
EnvironmentFile=-/etc/alba/alba.env
ExecStart=/usr/bin/java -Xmx384m -jar /opt/alba/app.jar
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target

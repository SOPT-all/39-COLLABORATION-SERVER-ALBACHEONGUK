# .env로 복사한 뒤 {...}를 실제 값으로 변경해서 사용하세요!!
spring.profiles.active=dev
SUPABASE_DB_URL=jdbc:postgresql://{SESSION_POOLER_HOST}:5432/postgres?sslmode=require&currentSchema=alba
SUPABASE_DB_USERNAME=postgres.{PROJECT_REF}
SUPABASE_DB_PASSWORD={DB_PASSWORD}
SUPABASE_URL=https://{PROJECT_REF}.supabase.co

# 서버 전용 sb_secret_... 키 또는 기존 service_role JWT를 입력하세요.
SUPABASE_SECRET_KEY={SERVER_SECRET_KEY}
SUPABASE_IMAGE_BUCKET=job-images
SUPABASE_STORAGE_ENABLED=true
SUPABASE_SIGNED_URL_TTL_SECONDS=600
SUPABASE_CONNECT_TIMEOUT=3s
SUPABASE_READ_TIMEOUT=5s
